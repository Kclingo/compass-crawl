{
  "name": "FeedbackReceipt",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "attendee_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "submitted": {
      "type": "boolean",
      "default": true
    },
    "submitted_at": {
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "attendee_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}