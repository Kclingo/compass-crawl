{
  "name": "Provider",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "credentials": {
      "type": "string",
      "description": "Letters after the name, e.g. LMHC"
    },
    "photo": {
      "type": "string"
    },
    "business": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "bio": {
      "type": "string",
      "description": "Two to three sentences"
    },
    "services": {
      "type": "string"
    },
    "offer": {
      "type": "string",
      "description": "Optional offer for crawl guests"
    },
    "booking_link": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "instagram": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}