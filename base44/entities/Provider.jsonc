{
  "name": "Provider",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "photo": {
      "type": "string"
    },
    "business": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "services": {
      "type": "string"
    },
    "booking_link": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "instagram": {
      "type": "string"
    },
    "tiktok": {
      "type": "string"
    },
    "linkedin": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "offer": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "user_id": {
      "type": "string",
      "description": "The provider login account that owns this profile"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}