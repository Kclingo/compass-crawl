{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "awareness_theme": {
      "type": "string",
      "description": "The theme line for this crawl, e.g. Grateful & Grounded"
    },
    "host": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "venue": {
      "type": "string"
    },
    "start_time": {
      "type": "string",
      "description": "Doors open, 24h HH:MM"
    },
    "welcome_time": {
      "type": "string"
    },
    "last_call_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "live",
        "closed"
      ],
      "default": "draft"
    },
    "capacity": {
      "type": "number",
      "default": 40
    },
    "waitlist_message": {
      "type": "string",
      "default": "This Crawl is full. Join the list for next month."
    },
    "check_in_open": {
      "type": "boolean",
      "default": true
    },
    "check_in_closes_at": {
      "type": "string",
      "description": "Time check-in (and cause changes) close, 24h HH:MM"
    },
    "feedback_opens_at": {
      "type": "string",
      "description": "Time anonymous feedback opens, 24h HH:MM"
    },
    "reminder_lead_minutes": {
      "type": "number",
      "default": 5,
      "description": "How many minutes before a showcase the reminder fires"
    },
    "slot_length_minutes": {
      "type": "number",
      "default": 20
    },
    "showcases_at_a_time": {
      "type": "number",
      "default": 1
    },
    "gift_suggested_amount": {
      "type": "number",
      "default": 5
    },
    "run_of_show": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "time": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "title",
    "date"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}