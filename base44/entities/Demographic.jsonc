{
  "name": "Demographic",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "attendee_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "age_range": {
      "type": "string"
    },
    "zip_code": {
      "type": "string"
    },
    "referral_source": {
      "type": "string"
    },
    "first_crawl": {
      "type": "string",
      "description": "Yes, No, or Prefer not to say"
    }
  },
  "required": [
    "event_id",
    "attendee_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}