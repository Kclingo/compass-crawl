{
  "name": "Feedback",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "overall_rating": {
      "type": "number"
    },
    "favorite_stop": {
      "type": "string",
      "description": "The stop or showcase the guest liked most"
    },
    "improvement": {
      "type": "string",
      "description": "One thing to change"
    },
    "would_return": {
      "type": "string",
      "enum": [
        "yes",
        "maybe",
        "no"
      ]
    }
  },
  "required": [
    "event_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}