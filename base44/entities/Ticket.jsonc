{
  "name": "Ticket",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "attendee_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "price_tier": {
      "type": "string",
      "enum": [
        "early_bird",
        "general",
        "ceiling",
        "comp"
      ]
    },
    "amount_paid": {
      "type": "number"
    },
    "promo_code": {
      "type": "string"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "refunded"
      ],
      "default": "pending"
    },
    "payment_ref": {
      "type": "string"
    },
    "eighteen_confirmed": {
      "type": "boolean",
      "default": false
    },
    "text_opt_in": {
      "type": "boolean",
      "default": false
    },
    "remind_all": {
      "type": "boolean",
      "default": false
    },
    "checked_in_at": {
      "type": "string"
    },
    "age_range": {
      "type": "string"
    },
    "zip_code": {
      "type": "string"
    },
    "referral_source": {
      "type": "string"
    },
    "first_crawl": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "cancelled"
      ],
      "default": "active"
    }
  },
  "required": [
    "event_id",
    "attendee_name",
    "email"
  ]
}