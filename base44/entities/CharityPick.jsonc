{
  "name": "CharityPick",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "attendee_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "charity_id": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "default": 0,
      "description": "Gift dollars attributed to this cause"
    }
  },
  "required": [
    "event_id",
    "attendee_id",
    "charity_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}