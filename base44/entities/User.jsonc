{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "account_type": {
      "type": "string",
      "description": "Chosen at sign-up: an attendee passport or a provider profile login",
      "enum": [
        "attendee",
        "provider"
      ],
      "default": "attendee"
    }
  },
  "required": [
    "role"
  ]
}